---
import PageLayout from "@/layouts/Base";
import { Image } from "astro:assets";
import aboutImg from "@/assets/about-astro.png";
import chowLiuImg from "@/assets/chow-liu.png";
import ariseImg from "@/assets/arise.png";
import threeProngedImg from "@/assets/a-three-pronged.png";
import UpdatesTimeline from "@/components/blog/UpdatesTimeline";
import SocialList from "@/components/SocialList";
import { getAllPosts, sortMDByDate } from "@/utils";

const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);

const publications: Array<{ title: string; authors: string; venue: string; year: number; link?: string; linkLabel?: string; oral?: boolean; img: ImageMetadata }> = [
	{
		title: "Chow-Liu Ordering for Long-Context Reasoning in Chain-of-Agents",
		authors: "Naman Gupta*, Vaibhav Singh*, Arun Iyer, Kirankumar Shiragur, Pratham Grover, Ramakrishna B. Bairi, Ritabrata Maiti, Sankarshan Damle, Shachee Mishra Gupta, Rishikesh Maurya, Vageesh D. C",
		venue: "ICLR 2026 Workshop on MemAgents",
		oral: true,
		year: 2026,
		link: "https://openreview.net/forum?id=krfs16Y8SA",
		linkLabel: "OpenReview",
		img: chowLiuImg,
	},
	{
		title: "ARISE: Iterative Rule Induction and Synthetic Data Generation for Text Classification",
		authors: "Yashwanth M., Vaibhav Singh, Ayush Maheshwari, Amrith Krishna, Ganesh Ramakrishnan",
		venue: "Findings of NAACL 2025",
		year: 2025,
		link: "https://aclanthology.org/2025.findings-naacl.359/",
		linkLabel: "ACL Anthology",
		img: ariseImg,
	},
	{
		title: "A Three-Pronged Approach to Cross-Lingual Adaptation with Multilingual LLMs",
		authors: "Vaibhav Singh, Amrith Krishna, Karthika NJ, Ganesh Ramakrishnan",
		venue: "arXiv Preprint",
		year: 2024,
		link: "https://arxiv.org/abs/2406.17377",
		linkLabel: "arXiv",
		img: threeProngedImg,
	},
];
---

<PageLayout meta={{ title: "Home" }}>
	<section>
		<h1 class="title mb-6">Hey There!</h1>
		<div class="flow-root">
			<div
				class="mx-auto mb-6 flex w-full max-w-[200px] flex-col items-center gap-3 sm:float-right sm:mb-4 sm:ms-6"
			>
				<Image
					src={aboutImg}
					alt="Portrait of Vaibhav Singh"
					loading="eager"
					fetchpriority="high"
					width={200}
					class="w-40 flex-shrink-0 rounded-lg sm:w-[200px]"
				/>
				<SocialList />
			</div>
			<div class="space-y-5 text-left leading-relaxed">
				<div class="space-y-1">
					<p class="font-semibold text-accent">I am seeking PhD opportunities for Fall 2027.</p>
					<p class="text-sm text-textColor/80">My CV is currently under update.</p>
				</div>
				<p>
					I am a Research Fellow at Microsoft Research India, in the Future of Scalable Software
					Engineering (FoSSE) group, under the guidance of <a
						href="https://scholar.google.com/citations?user=Ngm0j_EAAAAJ&hl=en"
						class="cactus-link"
						target="_blank"
						rel="noopener noreferrer">Arun Iyer</a
					> and <a
						href="https://scholar.google.com/citations?user=o-EdErcAAAAJ&hl=en"
						class="cactus-link"
						target="_blank"
						rel="noopener noreferrer">Sriram Rajamani</a
					>.
				</p>
				<p>
					My research at Microsoft focuses on AI for software engineering, particularly methods for
					experiential learning in LLM agents. I have been fortunate to work on three research
					problems (in that order):
				</p>
				<ol class="list-decimal space-y-3 ps-5">
					<li>
						How to learn reusable knowledge bases from engineering knowledge embedded in pull
						requests and commit history of very large codebases.
					</li>
					<li>
						How to enable experiential learning in LLM agents through novel mechanisms for using and
						refining these knowledge bases on unseen codebases.
					</li>
					<li>
						How to leverage these long-horizon agentic trajectories to post-train LLMs using RL
						(building on top of OPD and RLVR).
					</li>
				</ol>
				<p>
					On the engineering side, I have also built autonomous agent execution infrastructure for
					long-horizon software-engineering tasks, like migration of very large .NET codebases at
					Microsoft.
				</p>
				<p>
					I completed my M.Tech in Computer Science and Engineering at IIT Bombay, advised by Prof.
					<a
						href="https://scholar.google.com/citations?user=W1ZpREMAAAAJ&hl=en"
						class="cactus-link"
						target="_blank"
						rel="noopener noreferrer">Ganesh Ramakrishnan</a
					>, where I worked on parameter-efficient adaptation, distillation, and merging in LLMs.
				</p>
				<p>
					<strong>Research Interests:</strong> Continual Learning, On-policy RL for LLMs
				</p>
			</div>
		</div>
	</section>
	<section aria-labelledby="publications-heading" class="mt-16">
		<h2 id="publications-heading" class="title mb-6 text-xl">Publications / Pre-prints</h2>
		<ul class="divide-y divide-textColor/10">
			{
				publications.map(({ title, authors, venue, year, link, linkLabel, oral, img }) => (
					<li class="publication-entry grid items-start gap-4 py-6 first:pt-0 last:pb-0 sm:grid-cols-[160px_minmax(0,1fr)] sm:gap-6">
						<div class="publication-thumbnail hidden overflow-hidden rounded-lg border border-textColor/10 bg-white sm:block">
							<div class="aspect-h-3 aspect-w-4">
								<Image
									src={img}
									alt={title}
									width={360}
									densities={[1, 2]}
									class="h-full w-full object-contain p-3"
								/>
							</div>
						</div>
						<div class="min-w-0">
							<h3 class="break-words text-base font-semibold leading-6 text-accent-2">
								{title}
							</h3>
							<p class="publication-authors mt-2 text-xs leading-5 text-textColor/70">
								{authors.split(", ").map((author, index) => (
									<>
										{index > 0 && ", "}
										{author.replace(/\*$/, "") === "Vaibhav Singh" ? (
											<strong class="font-semibold text-accent-2">{author}</strong>
										) : (
											author
										)}
									</>
								))}
							</p>
							<p class="publication-venue mt-2 text-xs leading-6 text-textColor/70">
								<span class="font-medium text-textColor">{venue}</span>
								<span class="whitespace-nowrap">{" "}&middot; {year}</span>
								{oral && (
									<span class="ml-2 inline-block rounded-full border border-accent/20 bg-accent/10 px-2 py-0.5 align-middle text-[10px] font-semibold leading-4 text-accent">
										Oral
									</span>
								)}
							</p>
							{link && (
								<div class="mt-3">
									<a
										href={link}
										target="_blank"
										rel="noopener noreferrer"
										class="publication-link inline-flex items-center gap-1.5 rounded-md border border-textColor/20 px-2.5 py-1 text-xs font-medium leading-5 text-textColor transition-colors hover:border-accent/40 hover:bg-accent/5 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none"
									>
										{linkLabel ?? "Paper"}
										<svg
											xmlns="http://www.w3.org/2000/svg"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"
											stroke-linejoin="round"
											class="h-3.5 w-3.5"
											aria-hidden="true"
											focusable="false"
										>
											<path d="M7 17 17 7M7 7h10v10" />
										</svg>
										<span class="sr-only"> (opens in a new tab)</span>
									</a>
								</div>
							)}
						</div>
					</li>
				))
			}
		</ul>
	</section>
	<section aria-labelledby="updates-heading" class="mt-16">
		<h2 id="updates-heading" class="title mb-6 text-xl">Updates</h2>
		<UpdatesTimeline posts={allPostsByDate} />
	</section>
</PageLayout>
