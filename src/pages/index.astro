---
import PageLayout from "@/layouts/Base";
import { Image } from "astro:assets";
import aboutImg from "@/assets/about-astro.png";
import chowLiuImg from "@/assets/chow-liu.png";
import ariseImg from "@/assets/arise.png";
import threeProngedImg from "@/assets/a-three-pronged.png";
import PostPreview from "@/components/blog/PostPreview";
import SocialList from "@/components/SocialList";
import { getAllPosts, sortMDByDate } from "@/utils";

const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);

const publications: Array<{ title: string; authors: string; venue: string; year: number; link?: string; linkLabel?: string; oral?: boolean; img: ImageMetadata }> = [
	{
		title: "Chow-Liu Ordering for Long-Context Reasoning in Chain-of-Agents",
		authors: "Naman Gupta*, Vaibhav Singh*, Arun Iyer, Kirankumar Shiragur, Pratham Grover, Ramakrishna B. Bairi, Ritabrata Maiti, Sankarshan Damle, Shachee Mishra Gupta, Rishikesh Maurya, Vageesh D. C",
		venue: "ICLR 2026 Workshop on MemAgents",
		oral: true,
		year: 2026,
		link: "https://openreview.net/forum?id=krfs16Y8SA",
		linkLabel: "OpenReview",
		img: chowLiuImg,
	},
	{
		title: "ARISE: Iterative Rule Induction and Synthetic Data Generation for Text Classification",
		authors: "Yashwanth M., Vaibhav Singh, Ayush Maheshwari, Amrith Krishna, Ganesh Ramakrishnan",
		venue: "Findings of NAACL 2025",
		year: 2025,
		link: "https://aclanthology.org/2025.findings-naacl.359/",
		linkLabel: "ACL Anthology",
		img: ariseImg,
	},
	{
		title: "A Three-Pronged Approach to Cross-Lingual Adaptation with Multilingual LLMs",
		authors: "Vaibhav Singh, Amrith Krishna, Karthika NJ, Ganesh Ramakrishnan",
		venue: "arXiv Preprint",
		year: 2024,
		link: "https://arxiv.org/abs/2406.17377",
		linkLabel: "arXiv",
		img: threeProngedImg,
	},
];
---

<PageLayout meta={{ title: "Home" }}>
	<section>
		<h1 class="title mb-6">Hey There!</h1>
		<div class="space-y-6">
  <div class="flex items-center space-x-6">
    <div class="space-y-4">
  <p style="text-align: justify;">
    I am a Research Fellow at Microsoft Research India, in the Future of Scalable Software Engineering (FoSSE) group, under the guidance of Arun Iyer and Sriram Rajamani. My current research focuses on Long Context Modeling, Memory Management, and RL in LLMs (Agentic) for long-horizon software engineering tasks.
  </p>
  <p style="text-align: justify;">
    I completed my M.Tech in Computer Science and Engineering at IIT Bombay, advised by Prof. Ganesh Ramakrishnan, where I worked on parameter-efficient adaptation, distillation, and merging in LLMs, with downstream applications in cross-lingual NLP and robust out-of-distribution generalization.
  </p>
  <p style="text-align: justify;">
    <strong>Research Interests:</strong> Continual Learning, Long Context Reasoning, Memory-Augmented Agents
  </p>
</div>
    <Image
      src={aboutImg}
      alt="A cartoon cactus looking at the 'Astro.build' logo"
      loading="eager"
      fetchpriority="high"
      width={200}
    />
  </div>
</div>
		<SocialList />
	</section>
	<section class="mt-16">
		<h2 class="title mb-4 text-xl">Publications</h2>
		<ul class="space-y-4">
			{
				publications.map(({ title, authors, venue, year, link, linkLabel, oral, img }) => (
					<li class="flex gap-4">
						<div class="hidden sm:block flex-shrink-0 w-[180px]">
							<Image src={img} alt={title} width={360} densities={[1, 2]} class="rounded border border-border w-full h-auto" />
						</div>
						<div class="border-l-2 border-accent pl-4">
						<p class="font-semibold">{title}</p>
						<p class="text-sm text-muted-foreground">{authors}</p>
						<p class="text-sm">
							<span class="italic">{venue}</span>, {year}
							{oral && (
								<span class="ml-2 inline-block rounded-sm bg-accent/10 px-1.5 py-0.5 text-xs font-bold text-accent">
									Oral
								</span>
							)}
							{link && (
								<>
									{" "}·{" "}
									<a
										href={link}
										target="_blank"
										rel="noopener noreferrer"
										class="cactus-link"
									>
										{linkLabel}
									</a>
								</>
							)}
						</p>
						</div>
					</li>
				))
			}
		</ul>
	</section>
	<section aria-label="Blog post list" class="mt-16">
		<h2 class="title mb-4 text-xl">Posts</h2>
		<ul class="space-y-4 sm:space-y-2">
			{
				allPostsByDate.map((p) => (
					<li class="flex flex-col gap-x-2 sm:flex-row">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>
