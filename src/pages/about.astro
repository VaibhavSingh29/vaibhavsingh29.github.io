---
import { Image } from "astro:assets";

import PageLayout from "@/layouts/Base";
import aboutImg from "@/assets/about-astro.png";

const meta = {
	title: "About",
	description: "I'm a starter theme for Astro.build",
};
---

<PageLayout meta={meta}>
	<div class="space-y-6">
		<h1 class="title">About</h1>
		<div class="flex flex-col items-center gap-6 sm:flex-row">
			<div class="min-w-0 space-y-5 text-left leading-relaxed">
				<p>
					I am currently pursuing my final year of M.Tech in Computer Science and Engineering
					at IIT Bombay, with a focus on Deep Learning and Natural Language Processing as my
					primary areas of research. I am currently working on model merging via task and
					language vector arithmetic.
				</p>
				<p>
					Academic Supervision: I am advised by Prof. Ganesh Ramakrishnan, Professor, IIT
					Bombay.
				</p>
			</div>
			<Image
				src={aboutImg}
				alt="Portrait of Vaibhav Singh"
				loading="eager"
				fetchpriority="high"
				width={200}
				class="w-40 flex-shrink-0 rounded-lg sm:w-[200px]"
			/>
		</div>
	</div>
	
