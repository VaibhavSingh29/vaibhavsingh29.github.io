---
import { cvUrl } from "@/site-config";

const previewUrl = new URL(cvUrl);
if (
	previewUrl.origin !== "https://drive.google.com" ||
	!/^\/file\/d\/[A-Za-z0-9_-]+\/(?:view|preview)\/?$/.test(previewUrl.pathname)
) {
	throw new Error("The CV viewer requires a Google Drive file URL.");
}
previewUrl.pathname = previewUrl.pathname.replace(/\/(?:view|preview)\/?$/, "/preview");
previewUrl.searchParams.delete("usp");
---

<cv-preview class="contents" data-preview-url={previewUrl.href}>
	<dialog
		id="cv-preview-dialog"
		aria-labelledby="cv-preview-title"
		class="cv-dialog overflow-hidden bg-bgColor p-0 text-textColor"
	>
		<div class="flex h-full min-h-0 flex-col">
			<header
				class="flex shrink-0 items-center justify-between gap-4 border-b border-textColor/10 px-3 py-2 sm:px-4"
			>
				<h2 id="cv-preview-title" class="text-base font-semibold text-accent-2">
					Curriculum vitae
				</h2>
				<form method="dialog">
					<button
						data-cv-close
						type="submit"
						aria-label="Close CV"
						class="inline-flex h-8 w-8 items-center justify-center rounded-md text-textColor transition-colors hover:bg-accent/10 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none"
					>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							class="h-5 w-5"
							aria-hidden="true"
							focusable="false"
						>
							<path d="m6 6 12 12M6 18 18 6"></path>
						</svg>
					</button>
				</form>
			</header>
			<div class="relative min-h-0 flex-1 bg-textColor/5">
				<div data-cv-frame class="h-full w-full"></div>
				<div data-cv-loading hidden class="absolute inset-0 bg-bgColor">
					<div class="flex h-full items-center justify-center p-4">
						<p data-cv-status role="status" class="max-w-sm text-center text-textColor/70"></p>
					</div>
				</div>
			</div>
			<footer
				class="flex shrink-0 flex-wrap items-center justify-between gap-2 border-t border-textColor/10 px-3 py-2 sm:px-4"
			>
				<p class="text-xs text-textColor/70">CV not loading?</p>
				<a
					href={cvUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center rounded-md border border-textColor/20 px-2.5 py-1 text-xs font-medium leading-5 transition-colors hover:border-accent/40 hover:bg-accent/5 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none"
				>
					Open in Drive
					<span class="sr-only"> (opens in a new tab)</span>
				</a>
			</footer>
		</div>
	</dialog>
</cv-preview>

<script>
	class CVPreview extends HTMLElement {
		private cleanup: (() => void) | undefined;

		connectedCallback() {
			this.cleanup?.();

			const dialog = this.querySelector("dialog");
			const frameContainer = this.querySelector<HTMLDivElement>("[data-cv-frame]");
			const loading = this.querySelector<HTMLDivElement>("[data-cv-loading]");
			const status = this.querySelector<HTMLParagraphElement>("[data-cv-status]");
			const closeButton = this.querySelector<HTMLButtonElement>("[data-cv-close]");
			const previewUrl = this.dataset["previewUrl"];

			if (!dialog || !frameContainer || !loading || !status || !closeButton || !previewUrl) {
				throw new Error("The CV viewer is missing its required markup or document URL.");
			}
			if (typeof dialog.showModal !== "function") return;

			const events = new AbortController();
			const { signal } = events;
			let frameEvents: AbortController | undefined;
			let loadingTimer: number | undefined;
			let previousOverflow: string | undefined;
			let opener: HTMLAnchorElement | undefined;

			const clearLoadingTimer = () => {
				if (loadingTimer !== undefined) {
					window.clearTimeout(loadingTimer);
					loadingTimer = undefined;
				}
			};

			const reset = (restoreFocus: boolean) => {
				clearLoadingTimer();
				frameEvents?.abort();
				frameEvents = undefined;
				frameContainer.replaceChildren();
				frameContainer.removeAttribute("aria-busy");
				loading.hidden = true;
				status.textContent = "";
				if (previousOverflow !== undefined) {
					document.documentElement.style.overflow = previousOverflow;
					previousOverflow = undefined;
				}
				const trigger = opener;
				opener = undefined;
				if (restoreFocus && trigger?.isConnected) {
					trigger.focus({ preventScroll: true });
				}
			};

			const closePreview = (restoreFocus: boolean) => {
				if (dialog.open) dialog.close();
				reset(restoreFocus);
			};

			for (const trigger of document.querySelectorAll<HTMLAnchorElement>("a[data-cv-preview]")) {
				trigger.setAttribute("aria-haspopup", "dialog");
				trigger.setAttribute("aria-controls", dialog.id);
			}

			document.addEventListener(
				"click",
				(event) => {
					if (
						event.defaultPrevented ||
						event.button !== 0 ||
						event.metaKey ||
						event.ctrlKey ||
						event.shiftKey ||
						event.altKey ||
						!(event.target instanceof Element)
					) {
						return;
					}
					const trigger = event.target.closest<HTMLAnchorElement>("a[data-cv-preview]");
					if (!trigger) return;
					event.preventDefault();
					if (dialog.open) return;

					reset(false);
					opener = trigger;
					const frame = document.createElement("iframe");
					frame.src = previewUrl;
					frame.title = "CV hosted on Google Drive";
					frame.className = "h-full w-full border-0";
					frame.referrerPolicy = "no-referrer";
					frameEvents = new AbortController();
					frame.addEventListener(
						"load",
						() => {
							clearLoadingTimer();
							loading.hidden = true;
							frameContainer.removeAttribute("aria-busy");
						},
						{ once: true, signal: frameEvents.signal },
					);
					frame.addEventListener(
						"error",
						() => {
							clearLoadingTimer();
							frameContainer.removeAttribute("aria-busy");
							loading.hidden = false;
							status.textContent = "The CV could not load. Use Open in Drive below.";
						},
						{ once: true, signal: frameEvents.signal },
					);

					dialog.showModal();
					previousOverflow = document.documentElement.style.overflow;
					document.documentElement.style.overflow = "hidden";
					loading.hidden = false;
					status.textContent = "Loading CV...";
					frameContainer.setAttribute("aria-busy", "true");
					closeButton.focus({ preventScroll: true });
					loadingTimer = window.setTimeout(() => {
						loadingTimer = undefined;
						status.textContent =
							"The CV is taking longer than expected. You can open the CV in Google Drive below.";
					}, 10000);
					frameContainer.append(frame);
				},
				{ signal },
			);

			dialog.addEventListener(
				"close",
				() => {
					if (!dialog.open) reset(true);
				},
				{ signal },
			);
			dialog.addEventListener(
				"click",
				(event) => {
					if (event.target !== dialog) return;
					const bounds = dialog.getBoundingClientRect();
					if (
						event.clientX < bounds.left ||
						event.clientX > bounds.right ||
						event.clientY < bounds.top ||
						event.clientY > bounds.bottom
					) {
						closePreview(true);
					}
				},
				{ signal },
			);
			// Keep page shortcuts, such as search, from opening over the CV viewer.
			dialog.addEventListener("keydown", (event) => event.stopPropagation(), { signal });

			this.cleanup = () => {
				events.abort();
				closePreview(false);
			};
		}

		disconnectedCallback() {
			this.cleanup?.();
			this.cleanup = undefined;
		}
	}

	if (!customElements.get("cv-preview")) {
		customElements.define("cv-preview", CVPreview);
	}
</script>

<style>
	.cv-dialog {
		position: fixed;
		inset: 0;
		width: 100%;
		max-width: none;
		height: 100vh;
		height: 100dvh;
		max-height: none;
		margin: 0;
		border: 0;
	}

	.cv-dialog:not([open]) {
		display: none;
	}

	.cv-dialog::backdrop {
		background: hsl(0 0% 0% / 0.6);
	}

	@media (min-width: 640px) {
		.cv-dialog {
			width: calc(100% - 2rem);
			height: calc(100vh - 2rem);
			height: calc(100dvh - 2rem);
			margin: auto;
			border: 1px solid hsl(var(--theme-text) / 0.2);
			border-radius: 0.75rem;
			box-shadow: 0 1.5rem 5rem hsl(0 0% 0% / 0.3);
		}
	}
</style>
