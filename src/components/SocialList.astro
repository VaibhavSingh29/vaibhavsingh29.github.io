---
import { Icon } from "astro-icon";

/** 
	Uses https://github.com/natemoo-re/astro-icon#readme
	Find icons @ https://icones.js.org/
*/
const socialLinks = [
	{
		name: "mdi:email",
		friendlyName: "Email",
		link: "mailto:contacttovaibhav@gmail.com",
	},
	{
		name: "simple-icons:googlescholar",
		friendlyName: "Scholar",
		link: "https://scholar.google.com/citations?user=2IpL7ioAAAAJ&hl=en",
	},
	{
		name: "mdi:github",
		friendlyName: "GitHub",
		link: "https://github.com/VaibhavSingh29",
	},
	{
		name: "mdi:linkedin",
		friendlyName: "LinkedIn",
		link: "https://www.linkedin.com/in/vaibhav-s-10263a248",
	},
	{
		name: "mdi:youtube",
		friendlyName: "Resume",
		link: "https://www.youtube.com/watch?v=TusY3CwMBwg",
	},
];
---

<nav aria-label="Contact and profiles" class="w-full">
	<ul class="flex items-center justify-center gap-1">
		{
			socialLinks.map(({ link, name, friendlyName }) => {
				const isEmail = name.includes("email") || friendlyName.toLowerCase().includes("email");
				return (
					<li class="flex">
						<a
							class="social-link inline-flex items-center justify-center rounded-sm p-1.5 text-textColor transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none"
							href={link}
							target="_blank"
							rel={`noopener noreferrer me ${isEmail ? "authn" : ""}`}
						>
							<Icon
								class="h-5 w-5 flex-shrink-0"
								name={name}
								aria-hidden="true"
								focusable="false"
							/>
							<span class="sr-only">{friendlyName}</span>
						</a>
					</li>
				);
			})
		}
	</ul>
</nav>
